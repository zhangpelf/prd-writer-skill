{
  "name": "PRD 自动生成工作流",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "prd-generator",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "接收需求",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "prd-generator"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"你是一位资深产品经理，擅长撰写清晰、结构化的产品需求文档（PRD）。请根据用户提供的产品主题和需求背景，撰写一份完整的 PRD。使用中文撰写，技术术语保留英文。每个需求必须包含可验证的验收标准。\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"产品/主题：\" + $json.body.topic + \"\\n\\n背景与需求：\" + $json.body.requirements + \"\\n\\n请撰写包含以下章节的完整 PRD（Markdown 格式）：\\n1. 概述（产品背景、目标用户、核心目标、成功指标）\\n2. 功能需求（用户故事、功能列表与优先级 P0/P1/P2、验收标准 Given/When/Then）\\n3. 非功能需求（性能、安全、兼容性、可扩展性）\\n4. 数据模型/接口设计（核心实体、API 定义）\\n5. 发布计划（里程碑、版本规划）\\n6. 风险评估（技术风险、业务风险、缓解措施）\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 4000\n}",
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "调用 LLM 生成 PRD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "manualFields": [
          {
            "name": "content",
            "value": "={{ $json.choices[0].message.content }}",
            "type": "string"
          },
          {
            "name": "filename",
            "value": "={{ 'prd-' + $now.format('YYYY-MM-DD') + '-' + $json.body.topic.replace(/[^a-zA-Z0-9\\u4e00-\\u9fa5]/g, '_') + '.md' }}",
            "type": "string"
          }
        ]
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "提取内容并构建文件名",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [650, 300]
    },
    {
      "parameters": {
        "fileName": "={{ $json.filename }}",
        "data": "={{ $json.content }}",
        "options": {
          "append": false
        }
      },
      "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
      "name": "保存 PRD 文件",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"PRD 生成成功\",\n  \"file\": $json.fileName,\n  \"topic\": $items()[0].json.body.topic\n}",
        "options": {}
      },
      "id": "e5f6a7b8-c9d0-1234-efab-345678901234",
      "name": "返回结果",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "接收需求": {
      "main": [
        [
          {
            "node": "调用 LLM 生成 PRD",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "调用 LLM 生成 PRD": {
      "main": [
        [
          {
            "node": "提取内容并构建文件名",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "提取内容并构建文件名": {
      "main": [
        [
          {
            "node": "保存 PRD 文件",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "保存 PRD 文件": {
      "main": [
        [
          {
            "node": "返回结果",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": []
}
